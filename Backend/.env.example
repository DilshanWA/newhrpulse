PORT=4000
# PostgreSQL connection string (e.g. Neon). Never commit the real value.
DATABASE_URL=
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
# At least 32 random characters. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Microsoft OAuth app credentials used by Better Auth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Optional: Google's Geocoding API for attendance place names (most accurate).
# Without it, place names come from OpenStreetMap (free, no key).
GOOGLE_MAPS_API_KEY=
# Optional: contact email passed to OpenStreetMap's geocoder, as its usage policy asks.
GEOCODER_CONTACT_EMAIL=

# Email (used to send payslips). Any SMTP provider works, e.g.
#   Microsoft 365: SMTP_HOST=smtp.office365.com SMTP_PORT=587 (the mailbox needs "Authenticated SMTP" enabled)
#   Google Workspace: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 (use an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Shown as the sender, e.g. "HR Pulse <hr@yourcompany.lk>". Defaults to SMTP_USER.
MAIL_FROM=
# Company name shown on payslip emails.
COMPANY_NAME=HR Pulse

# Optional: set this to a persistent disk mount for private contract uploads in production.
UPLOAD_DIR=uploads
