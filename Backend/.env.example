PORT=4000
# PostgreSQL connection string (e.g. Neon). Never commit the real value.
DATABASE_URL=
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
# At least 32 random characters. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Microsoft app credentials used by Better Auth sign-in and Microsoft Graph mail
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Optional: Google's Geocoding API for attendance place names (most accurate).
# Without it, place names come from OpenStreetMap (free, no key).
GOOGLE_MAPS_API_KEY=
# Optional: contact email passed to OpenStreetMap's geocoder, as its usage policy asks.
GEOCODER_CONTACT_EMAIL=

# Payslip email is sent via Microsoft Graph (requires the Mail.Send application permission and admin consent).
# Set this to the sender mailbox's exact Entra UPN in the tenant above (not an alias).
# The legacy MAIL_FROM alias is accepted if this is blank.
MAIL_FROM_ADDRESS=
# Legacy sender-address alias; MAIL_FROM_ADDRESS takes precedence.
MAIL_FROM=
COMPANY_NAME=HR Pulse
# Optional: set this to a persistent disk mount for private contract uploads in production.
UPLOAD_DIR=uploads
AZURE_AD_REDIRECT_URI=http://localhost:4000/auth/callback
NEXTAUTH_URL=http://localhost:3000
# Mail is sent via Microsoft Graph, not SMTP:
# POST https://graph.microsoft.com/v1.0/users/hrpulse@studyingermany.lk/sendMail
# with a client-credentials token (scope https://graph.microsoft.com/.default)
# using the AZURE_AD_* values above.
MAIL_PROVIDER=graph
MAIL_FROM_ADDRESS=admin@studyingermany.lk
MAIL_FROM_NAME=HR Pulse
COMPANY_NAME=Studyingermany.lk