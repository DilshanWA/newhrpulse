# ---- Data source ----
# "mock" = in-browser demo data (no backend needed)
# "api"  = call your real backend through src/lib/http.ts
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Vercel: set NEXT_PUBLIC_DATA_SOURCE=api, NEXT_PUBLIC_API_URL=/api,
# and HR_PULSE_API_ORIGIN to your backend HTTPS origin (without /api).
# HR_PULSE_API_ORIGIN=https://your-backend.example.com

